# Normalize line endings to LF in the repo and working tree on every OS.
# Without this, Windows checkouts (core.autocrlf=true) get CRLF endings and
# `gofmt -l` reports every Go file as unformatted.
* text=auto eol=lf

*.go text eol=lf
*.mod text eol=lf
*.sum text eol=lf
*.nil text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
