// Alap Web Application in Nilang
import { App, Page, Button, Text, Column } from "alap/web"

@Component
component Counter {
    @State count: i32 = 0

    build() {
        Column {
            Text("Nilang Web Counter: " + count.toString())
            Button("+ Increment") {
                count = count + 1
            }
        }
    }
}

function main(): void {
    print("Alap Web Client App Booted")
}
