// counter.nil — NilLang Counter example
// Demonstrates: variables, functions, loops, closures
// Run: alapc -in examples/counter/main.nil -run

struct Counter {
    value: Int,
    step: Int,
    name: string,
}

fn createCounter(name: string, step: Int) -> Counter {
    return Counter { value: 0, step: step, name: name }
}

fn increment(c: Counter) -> Int {
    c.value = c.value + c.step
    return c.value
}

fn decrement(c: Counter) -> Int {
    c.value = c.value - c.step
    return c.value
}

fn reset(c: Counter) -> Void {
    c.value = 0
}

fn displayCounter(c: Counter) -> Void {
    print("[" + c.name + "] value = " + c.value.toString() + " (step=" + c.step.toString() + ")")
}

fn factorial(n: Int) -> Int {
    if n <= 1 {
        return 1
    }
    return n * factorial(n - 1)
}

fn fibonacci(n: Int) -> Int {
    if n <= 1 {
        return n
    }
    return fibonacci(n - 1) + fibonacci(n - 2)
}

fn sumRange(start: Int, to: Int) -> Int {
    let sum: Int = 0
    let i: Int = start
    while i <= to {
        sum = sum + i
        i = i + 1
    }
    return sum
}

fn main() -> Void {
    print("=== NilLang Counter Demo ===")
    print("")

    // Basic counter
    let c1 = createCounter("Counter-1", 1)
    let c2 = createCounter("Counter-5", 5)

    print("--- Incrementing ---")
    increment(c1); displayCounter(c1)
    increment(c1); displayCounter(c1)
    increment(c1); displayCounter(c1)

    print("")
    print("--- Step-5 Counter ---")
    increment(c2); displayCounter(c2)
    increment(c2); displayCounter(c2)
    increment(c2); displayCounter(c2)

    print("")
    print("--- Decrement ---")
    decrement(c1); displayCounter(c1)

    print("")
    print("--- Reset ---")
    reset(c1); displayCounter(c1)

    print("")
    print("--- Factorial ---")
    let i: Int = 1
    while i <= 10 {
        print(i.toString() + "! = " + factorial(i).toString())
        i = i + 1
    }

    print("")
    print("--- Fibonacci ---")
    let j: Int = 0
    while j <= 10 {
        print("fib(" + j.toString() + ") = " + fibonacci(j).toString())
        j = j + 1
    }

    print("")
    print("--- Sum 1..100 = " + sumRange(1, 100).toString())

    print("")
    print("=== Done ===")
}

main()
