// todo.nil — NilLang Todo App (CLI version)
// Demonstrates: arrays, structs, enums, functions, match
// Run: alapc -in examples/todo/main.nil -run

enum TodoStatus {
    Pending,
    InProgress,
    Done,
    Cancelled
}

struct Todo {
    id: Int,
    title: string,
    status: string,
    priority: Int,
    tags: Array<string>,
}

fn createTodo(id: Int, title: string, priority: Int) -> Todo {
    return Todo {
        id: id,
        title: title,
        status: "Pending",
        priority: priority,
        tags: []
    }
}

fn markDone(todo: Todo) -> Void {
    todo.status = "Done"
}

fn markInProgress(todo: Todo) -> Void {
    todo.status = "InProgress"
}

fn displayTodo(todo: Todo) -> Void {
    let statusIcon: string = "⬜"
    if todo.status == "Done" {
        statusIcon = "✅"
    }
    if todo.status == "InProgress" {
        statusIcon = "🔄"
    }
    if todo.status == "Cancelled" {
        statusIcon = "❌"
    }
    print(statusIcon + " [" + todo.id.toString() + "] " + todo.title + " (priority=" + todo.priority.toString() + ")")
}

fn countByStatus(todos: Array<Todo>, status: string) -> Int {
    let count: Int = 0
    let i: Int = 0
    while i < todos.length {
        if todos[i].status == status {
            count = count + 1
        }
        i = i + 1
    }
    return count
}

fn filterByPriority(todos: Array<Todo>, minPriority: Int) -> Array<Todo> {
    let result: Array<Todo> = []
    let i: Int = 0
    while i < todos.length {
        if todos[i].priority >= minPriority {
            result.push(todos[i])
        }
        i = i + 1
    }
    return result
}

fn printStats(todos: Array<Todo>) -> Void {
    let total: Int = todos.length
    let done: Int = countByStatus(todos, "Done")
    let pending: Int = countByStatus(todos, "Pending")
    let inProgress: Int = countByStatus(todos, "InProgress")

    print("")
    print("=== Statistics ===")
    print("Total:       " + total.toString())
    print("Done:        " + done.toString())
    print("In Progress: " + inProgress.toString())
    print("Pending:     " + pending.toString())
}

fn main() -> Void {
    print("=== NilLang Todo App ===")
    print("")

    // Create todos
    let todos: Array<Todo> = [
    createTodo(1, "Set up Alap Framework", 5),
    createTodo(2, "Write NilLang compiler", 5),
    createTodo(3, "Implement VM runtime", 4),
    createTodo(4, "Build UI engine", 4),
    createTodo(5, "Create platform adapters", 3),
    createTodo(6, "Write documentation", 3),
    createTodo(7, "Add unit tests", 4),
    createTodo(8, "Set up CI/CD pipeline", 2),
    createTodo(9, "Publish to GitHub", 2),
    createTodo(10, "Deploy Onuron integration", 5)
    ]

    // Update some statuses
    markDone(todos[0])
    markDone(todos[1])
    markDone(todos[2])
    markInProgress(todos[3])
    markInProgress(todos[4])
    markInProgress(todos[6])

    print("--- All Todos ---")
    let i: Int = 0
    while i < todos.length {
        displayTodo(todos[i])
        i = i + 1
    }

    print("")
    print("--- High Priority (>= 4) ---")
    let highPriority = filterByPriority(todos, 4)
    let j: Int = 0
    while j < highPriority.length {
        displayTodo(highPriority[j])
        j = j + 1
    }

    printStats(todos)

    print("")
    print("=== Done ===")
}

main()
