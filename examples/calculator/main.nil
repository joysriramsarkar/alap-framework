// calculator.nil — NilLang advanced calculator
// Demonstrates: match, recursion, string operations, error handling
// Run: alapc -in examples/calculator/main.nil -run
// Canonical spelling (M4): `fn` + `->` + expression match arms.

fn printZero(msg: string) -> Int {
    print(msg)
    return 0
}

fn calc(a: Int, b: Int, op: string) -> Int {
    match op {
        "+" => a + b,
        "-" => a - b,
        "*" => a * b,
        "/" => b == 0 ? printZero("Error: division by zero!") : a / b,
        "%" => b == 0 ? printZero("Error: modulo by zero!") : a % b,
        _ => printZero("Unknown operator: " + op)
    }
}

fn isPrime(n: Int) -> bool {
    if n < 2 {
        return false
    }
    if n == 2 {
        return true
    }
    if n % 2 == 0 {
        return false
    }
    let i: Int = 3
    while i * i <= n {
        if n % i == 0 {
            return false
        }
        i = i + 2
    }
    return true
}

fn gcd(a: Int, b: Int) -> Int {
    while b != 0 {
        let temp: Int = b
        b = a % b
        a = temp
    }
    return a
}

fn lcm(a: Int, b: Int) -> Int {
    return a / gcd(a, b) * b
}

fn power(base: Int, exp: Int) -> Int {
    if exp == 0 {
        return 1
    }
    if exp == 1 {
        return base
    }
    if exp % 2 == 0 {
        let half: Int = power(base, exp / 2)
        return half * half
    }
    return base * power(base, exp - 1)
}

fn abs(n: Int) -> Int {
    if n < 0 {
        return 0 - n
    }
    return n
}

fn max(a: Int, b: Int) -> Int {
    if a > b { return a }
    return b
}

fn min(a: Int, b: Int) -> Int {
    if a < b { return a }
    return b
}

fn main() -> Void {
    print("=== NilLang Calculator ===")
    print("")

    // Basic operations
    print("--- Basic Arithmetic ---")
    let ops: Array<string> = ["+", "-", "*", "/", "%"]
    let i: Int = 0
    while i < ops.length {
        let op: string = ops[i]
        let result: Int = calc(17, 5, op)
        print("17 " + op + " 5 = " + result.toString())
        i = i + 1
    }

    print("")
    print("--- Powers ---")
    let j: Int = 0
    while j <= 10 {
        print("2^" + j.toString() + " = " + power(2, j).toString())
        j = j + 1
    }

    print("")
    print("--- Prime Numbers up to 50 ---")
    let primes: string = ""
    let k: Int = 2
    while k <= 50 {
        if isPrime(k) {
            if primes == "" {
                primes = k.toString()
            } else {
                primes = primes + ", " + k.toString()
            }
        }
        k = k + 1
    }
    print(primes)

    print("")
    print("--- GCD & LCM ---")
    print("gcd(48, 18) = " + gcd(48, 18).toString())
    print("lcm(4, 6)   = " + lcm(4, 6).toString())
    print("gcd(100, 75) = " + gcd(100, 75).toString())
    print("lcm(12, 18)  = " + lcm(12, 18).toString())

    print("")
    print("--- Min/Max/Abs ---")
    print("max(42, 17) = " + max(42, 17).toString())
    print("min(42, 17) = " + min(42, 17).toString())
    print("abs(-99)    = " + abs(-99).toString())

    print("")
    print("=== Done ===")
}

main()
