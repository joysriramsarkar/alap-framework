// hello.nil — NilLang Hello World
// Run: alapc -in examples/hello/main.nil -run
// Canonical spelling (M4): `fn` + `->` also compile with the nilLang toolchain.

fn greet(name: string) -> string {
    return "Hello, " + name + "! Welcome to Alap Framework."
}

fn main() -> Void {
    print("=== NilLang Hello World ===")

    let msg: string = greet("Onuron")
    print(msg)

    let msg2: string = greet("World")
    print(msg2)

    print("Alap Framework is running!")
}

main()
